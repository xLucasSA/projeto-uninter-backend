# Valores de demonstração para o ambiente local. Troque todos fora dele; o .env real nunca é versionado.

# Postgres
POSTGRES_DB=raizes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-dev
POSTGRES_HOST_PORT=5432
BACKOFFICE_DB_PASSWORD=backoffice-dev
API_DB_PASSWORD=api-dev
DEBEZIUM_DB_PASSWORD=debezium-dev

# Backoffice (Django)
DJANGO_SECRET_KEY=troque-por-um-valor-longo-e-aleatorio-com-32+
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backoffice
BACKOFFICE_DATABASE_URL=postgres://backoffice_app:backoffice-dev@postgres:5432/raizes
SEED_DEMO=true

# API (FastAPI)
API_DATABASE_URL=postgresql+asyncpg://api_app:api-dev@postgres:5432/raizes
READ_MODEL_SOURCE=write
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-bytes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
JWT_DEVICE_TTL_SECONDS=43200
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Pagamento
PAYMENT_GATEWAY_URL=http://payment-mock:8002
PAYMENT_GATEWAY_TIMEOUT_SECONDS=2
PAYMENT_GATEWAY_MAX_RETRIES=2
PAYMENT_WEBHOOK_SECRET=troque-por-um-segredo-de-webhook-com-32+
PAYMENT_WEBHOOK_URL=http://api:8001/webhooks/pagamentos
PAYMENT_MOCK_WEBHOOK_DELAY_MS=500

# CDC (profile cdc, T3)
API_READ_DATABASE_URL=postgresql+asyncpg://projector_app:projector-dev@postgres-read:5432/raizes_read
REDIS_URL=redis://redis:6379/0
